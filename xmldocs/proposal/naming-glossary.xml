        <row><cell><c>formulaColumn_&lt;x&gt;()</c>, <c>sql_formula_&lt;name&gt;()</c>, <c>subquery_&lt;name&gt;()</c>, <c>env_&lt;name&gt;()</c>, <c>pyColumn_&lt;name&gt;()</c></cell><cell>uguali</cell><cell>sì</cell><cell>namespace</cell></row>
